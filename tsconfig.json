{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "lib": ["DOM", "ES2020"],
    
    "rootDir": "./frontend/ts",
    "outDir": "./public/js",
    
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    
    "removeComments": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": [
    "frontend/ts/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}